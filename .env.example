# Server
PORT=3333
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/taisa-atelier

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# CORS — comma-separated list of allowed origins in production
# e.g. https://taisaatelier.com.br,https://www.taisaatelier.com.br
CORS_ORIGIN=

# Evolution API (WhatsApp) — see docker-compose.yml `evolution` service
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=minha-chave-secreta
EVOLUTION_INSTANCE=taisa-atelier
